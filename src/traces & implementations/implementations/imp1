### **3.1 Add AI Streaming Failure Monitoring**

**Problem:** Transient AI streaming failures not tracked

**Create new file:** `my-agent-directory/src/projects/blog-generator/utils/error-tracking.ts`

```typescript
import { Logger } from '@inkeep/agents-sdk';

export interface AIStreamError {
  timestamp: string;
  agentId: string;
  attemptNumber: number;
  inputTokens: number;
  outputTokens: number;
  errorMessage: string;
  recoveredSuccessfully: boolean;
}

export class ErrorTracker {
  private static errors: AIStreamError[] = [];
  
  static logAIStreamError(error: AIStreamError): void {
    this.errors.push(error);
    
    // Log to console for immediate visibility
    Logger.error('AI Stream Error', {
      agent: error.agentId,
      attempt: error.attemptNumber,
      recovered: error.recoveredSuccessfully
    });
    
    // If errors exceed threshold, alert
    const recentErrors = this.errors.filter(
      e => Date.now() - new Date(e.timestamp).getTime() < 300000 // 5 min
    );
    
    if (recentErrors.length >= 3) {
      Logger.warn('High AI stream failure rate detected', {
        count: recentErrors.length,
        timeWindow: '5 minutes'
      });
    }
  }
  
  static getErrorStats() {
    return {
      total: this.errors.length,
      byAgent: this.errors.reduce((acc, err) => {
        acc[err.agentId] = (acc[err.agentId] || 0) + 1;
        return acc;
      }, {} as Record<string, number>),
      recoveryRate: this.errors.filter(e => e.recoveredSuccessfully).length / this.errors.length
    };
  }
}
```

