### **5.1 Add Artifact Caching Strategy**

**Problem:** Repeated artifact retrievals are inefficient

**Create:** `my-agent-directory/src/projects/blog-generator/utils/artifact-cache.ts`

```typescript
export class ArtifactCache {
  private static cache = new Map<string, any>();
  private static ttl = 300000; // 5 minutes
  
  static set(key: string, value: any): void {
    this.cache.set(key, {
      value,
      timestamp: Date.now()
    });
  }
  
  static get(key: string): any | null {
    const cached = this.cache.get(key);
    if (!cached) return null;
    
    // Check if expired
    if (Date.now() - cached.timestamp > this.ttl) {
      this.cache.delete(key);
      return null;
    }
    
    return cached.value;
  }
  
  static clear(): void {
    this.cache.clear();
  }
}
```

